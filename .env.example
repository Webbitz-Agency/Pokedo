# Copia in .env.local. Backend: proxy /api → Flask (vedi vite.config).

# URL API in produzione (senza slash finale). Obbligatorio su Vercel se non usi il proxy in vercel.json.
# VITE_API_BASE=https://pokemanager.it

# Target proxy API in locale per Vite (dev/preview).
# Default: http://127.0.0.1:8000
# VITE_DEV_API_PROXY_TARGET=https://pokemanager.it

# Token pubblico del tenant (build vetrina un dominio = un cliente)
# VITE_PUBLIC_TENANT_TOKEN=

# Origine PokeManager (admin) per redirect e link footer (senza slash finale). Dev default: http://127.0.0.1:5174
# VITE_POKEMANAGER_ORIGIN=http://127.0.0.1:5174
